# Copy to .env for local dev. Real values live in the Vercel project settings.

VITE_SUPABASE_PROJECT_ID="ddpubhkgcbcwncyeebzc"
VITE_SUPABASE_URL="https://ddpubhkgcbcwncyeebzc.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon key>"

# REQUIRED for /workbook to work. The public URL of the zero-price DOWNLOAD
# product in Socioverse Planets. Its checkout collects the billing email, which
# is the lead, and delivers the PDF. Without it the page tells visitors to email
# Anshul directly rather than showing a broken frame.
VITE_WORKBOOK_PLANETS_URL="https://socioverse.io/anshulrastogi/<workbook-slug>"

# The PDF itself now lives in Socioverse Planets secure storage, uploaded to the
# product above - not in this repo and not on this domain. public/downloads/ is
# kept only so the path still resolves if you ever host it here instead.
