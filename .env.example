# OPTIONAL. The live product URL is the default in src/lib/data.ts, because it
# goes into 15 video descriptions and must not depend on a hosting env var being
# remembered. Set this only to point /workbook at a different Planets product.
# The page appends ?embed=1 for the iframe by itself - give it the plain URL.
# VITE_WORKBOOK_PLANETS_URL="https://www.socioverse.io/d/anshulrastogi/ai-sight-workbook"

# The PDF itself now lives in Socioverse Planets secure storage, uploaded to the
# product above - not in this repo and not on this domain. public/downloads/ is
# kept only so the path still resolves if you ever host it here instead.
